# Copia este archivo a .env y completa los valores.

# Prisma CLI (db push / generate) — usa archivo local en dev
DATABASE_URL="file:./dev.db"

# Turso (nube). Obtén estos valores con:
#   turso db show <tu-db> --url
#   turso db tokens create <tu-db>
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Secreto para firmar sesiones JWT (mínimo 32 caracteres)
AUTH_SECRET="genera-una-cadena-aleatoria-larga-y-segura"

NEXT_PUBLIC_APP_NAME="Capital Veci"
