// ============================================================
//  Capital Veci — Esquema de base de datos
//  Provider: SQLite / libSQL (Turso) vía driver adapter.
//  Nota: SQLite no soporta enums nativos en Prisma, por lo que
//  los estados se modelan como String con valores documentados
//  (ver src/lib/constants.ts).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
//  Usuarios y acceso
// ---------------------------------------------------------
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  // ADMIN | CONTADOR | OPERADOR | INVERSIONISTA
  role         String    @default("OPERADOR")
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Vínculo opcional con un inversionista (para el portal privado)
  investor   Investor? @relation(fields: [investorId], references: [id], onDelete: SetNull)
  investorId String?   @unique

  auditLogs             AuditLog[]
  responsibleOperations Operation[]       @relation("OperationResponsible")
  capitalAssignments    StaffAssignment[] @relation("StaffAssignmentUser")
  registeredAssignments StaffAssignment[] @relation("StaffAssignmentAuthor")
}

// ---------------------------------------------------------
//  Inversionistas
// ---------------------------------------------------------
model Investor {
  id              String   @id @default(cuid())
  fullName        String
  rut             String   @unique
  email           String?
  phone           String?
  // ACTIVE | FINISHED | RISK | BLOCKED
  status          String   @default("ACTIVE")
  investedCapital Float    @default(0)
  joinDate        DateTime @default(now())
  // Rentabilidad pactada anual (%)
  expectedReturn  Float    @default(0)
  // LOW | MEDIUM | HIGH
  riskLevel       String   @default("LOW")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User?
  contracts Contract[]
  payments  Payment[]
  documents Document[]

  operationParticipations OperationParticipant[]
}

// ---------------------------------------------------------
//  Plantillas de contratos
//  Modelos preconfigurados que aceleran la generación de
//  contratos digitales. Valores opcionales (returnRate,
//  durationMonths) representan "variable / según operación".
// ---------------------------------------------------------
model ContractTemplate {
  id                   String   @id @default(cuid())
  code                 String   @unique
  name                 String
  description          String?
  // FIXED | VARIABLE | PARTICIPATION
  modality             String   @default("FIXED")
  // MONTHLY | QUARTERLY | AT_MATURITY | CUSTOM
  paymentFrequency     String   @default("MONTHLY")
  customIntervalMonths Int?
  periodicInterestPct  Float    @default(100)
  // Si returnRate es null se considera "variable / según operación"
  returnRate           Float?
  // Override del texto mostrado en la tarjeta para la rentabilidad
  rateLabel            String?
  // Si durationMonths es null se considera "variable"
  durationMonths       Int?
  // Override del texto mostrado en la tarjeta para el plazo
  durationLabel        String?
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ---------------------------------------------------------
//  Contratos digitales
// ---------------------------------------------------------
model Contract {
  id                   String    @id @default(cuid())
  code                 String    @unique
  investor             Investor  @relation(fields: [investorId], references: [id], onDelete: Cascade)
  investorId           String
  amount               Float
  durationMonths       Int
  // Rentabilidad pactada (%)
  returnRate           Float
  // FIXED | VARIABLE | PARTICIPATION
  modality             String    @default("FIXED")
  // MONTHLY | QUARTERLY | AT_MATURITY | CUSTOM — define el modelo de pago
  paymentFrequency     String    @default("MONTHLY")
  // CUSTOM: cada cuántos meses se paga interés
  customIntervalMonths Int?
  // CUSTOM: % del interés del período que se paga (resto acumula al final)
  periodicInterestPct  Float     @default(100)
  startDate            DateTime
  endDate              DateTime
  // DRAFT | ACTIVE | SIGNED | EXPIRED | CANCELLED
  status               String    @default("DRAFT")
  conditions           String?
  signedAt             DateTime?
  signatureName        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  payments  Payment[]
  documents Document[]
}

// ---------------------------------------------------------
//  Pagos
// ---------------------------------------------------------
model Payment {
  id         String    @id @default(cuid())
  investor   Investor  @relation(fields: [investorId], references: [id], onDelete: Cascade)
  investorId String
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  contractId String?
  // INTEREST | CAPITAL_RETURN | MONTHLY | OTHER
  type       String    @default("MONTHLY")
  amount     Float
  dueDate    DateTime
  paidDate   DateTime?
  // PENDING | PAID | OVERDUE | SCHEDULED | CANCELLED
  status     String    @default("PENDING")
  method     String?
  reference  String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ---------------------------------------------------------
//  Operaciones comerciales
//
//  Una Operation representa EN QUÉ se está usando el dinero
//  administrado (compra de mercadería, préstamo, software, etc).
//
//  Flujo financiero del dinero:
//    - Al CREAR: capitalUsed sale de la liquidez disponible y
//      pasa a "capital comprometido" (sumado por status en metrics).
//      Se crea un CapitalMovement tipo COMMITTED para trazabilidad.
//    - Al FINALIZAR: returnAmount vuelve a la liquidez. El profit
//      (returnAmount - capitalUsed) se reparte pro rata entre
//      los participantes y la empresa. Se crea movement RETURN.
//    - En PÉRDIDA: la diferencia no recuperada queda como OUTFLOW
//      y baja el capital total administrado.
// ---------------------------------------------------------
model Operation {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  description   String?
  // MINIMARKET | LOANS | BARBERSHOP | SOFTWARE | CLEANING | IMPORTS | STOCK | COMMERCIAL | EXPANSION
  category      String  @default("COMMERCIAL")
  // Negocio o sucursal asociado (texto libre)
  business      String?
  // Usuario staff responsable de seguir la operación
  responsibleId String?
  responsible   User?   @relation("OperationResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  capitalUsed    Float  @default(0)
  // % esperado anualizado (informativo)
  expectedReturn Float  @default(0)
  // % real, calculado al finalizar = (returnAmount - capitalUsed) / capitalUsed * 100
  actualReturn   Float?
  // Monto bruto devuelto al finalizar (capital + utilidad o recuperado parcial)
  returnAmount   Float?
  // Utilidad o pérdida = returnAmount - capitalUsed (negativo si LOSS)
  profit         Float?

  // ACTIVE | FINISHED | RISK | PAUSED | LOSS
  status    String    @default("ACTIVE")
  // LOW | MEDIUM | HIGH
  riskLevel String    @default("MEDIUM")
  startDate DateTime
  endDate   DateTime?
  // Cuándo se cerró efectivamente (FINISHED o LOSS)
  closedAt  DateTime?
  result    String?

  // --- Cobro diario (préstamos en cuotas diarias) ---
  // Si está activo, la operación genera un calendario de cuotas (LoanInstallment).
  // El dinero recaudado SOLO se registra como cobranza; la liquidez se libera
  // recién al finalizar la operación (no por cuota).
  isDailyLoan     Boolean @default(false)
  // N° de cuotas/días de cobro (ej. 24, 20, 30)
  dailyTermDays   Int?
  // CSV de los días de la semana en que SÍ se cobra (0=Dom … 6=Sáb), ej "1,2,3,4,5,6"
  collectWeekdays String?
  // Cliente / deudor al que se le cobra
  borrowerName    String?
  borrowerPhone   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements    CapitalMovement[]
  participants OperationParticipant[]
  installments LoanInstallment[]
  loanPayments LoanPayment[]
}

// ---------------------------------------------------------
//  Cuotas diarias de un préstamo con cobro diario
//
//  Cada LoanInstallment es una cuota a cobrar en una fecha
//  específica. Es un registro de COBRANZA: marcarla como
//  cobrada no mueve liquidez por sí sola; el dinero se
//  consolida al finalizar la operación con el total cobrado.
// ---------------------------------------------------------
model LoanInstallment {
  id          String    @id @default(cuid())
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  operationId String
  // Número de cuota (1..N)
  sequence    Int
  dueDate     DateTime
  amount      Float
  // Monto acumulado efectivamente cobrado (abonos). remaining = amount - paidAmount.
  paidAmount  Float     @default(0)
  // PENDING | PARTIAL | PAID | OVERDUE
  status      String    @default("PENDING")
  paidDate    DateTime?
  method      String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([operationId])
  @@index([dueDate, status])
}

// ---------------------------------------------------------
//  Libro de cobros de un préstamo diario (historial de abonos)
//
//  Cada LoanPayment es UN evento de cobro: registra cuánto se
//  cobró, cuándo (fecha + hora), con qué método y QUÉ cuotas
//  cubrió (allocations: JSON con el desglose por cuota). Sirve
//  para demostrarle al deudor cómo se fueron haciendo los pagos
//  en partes, incluso cuando un pago cubre varias cuotas.
// ---------------------------------------------------------
model LoanPayment {
  id          String    @id @default(cuid())
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  operationId String
  // Monto total efectivamente aplicado en este cobro.
  amount      Float
  method      String?
  // JSON: [{ sequence, installmentId, amount }] — a qué cuotas se aplicó.
  allocations String
  createdAt   DateTime  @default(now())

  @@index([operationId])
}

// ---------------------------------------------------------
//  Participaciones de inversionistas en una operación
//
//  Un inversionista puede aportar parte de su capital a una
//  operación específica. Al finalizar con utilidad, recibe su
//  parte proporcional. Al cerrar con pérdida, la pérdida se
//  reparte igualmente pro rata.
// ---------------------------------------------------------
model OperationParticipant {
  id           String    @id @default(cuid())
  operation    Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  operationId  String
  investor     Investor  @relation(fields: [investorId], references: [id], onDelete: Cascade)
  investorId   String
  // Aporte de este inversionista a la operación
  amount       Float
  // Monto devuelto a este inversionista al cerrar la operación
  returnAmount Float?
  // Utilidad/pérdida del inversionista (returnAmount - amount)
  profit       Float?
  createdAt    DateTime  @default(now())

  @@unique([operationId, investorId])
}

// ---------------------------------------------------------
//  Movimientos de capital / tesorería
// ---------------------------------------------------------
model CapitalMovement {
  id          String     @id @default(cuid())
  // INFLOW | OUTFLOW | RESERVE | COMMITTED | RETURN
  type        String
  amount      Float
  category    String?
  description String?
  date        DateTime   @default(now())
  operation   Operation? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  operationId String?
  createdAt   DateTime   @default(now())
}

// ---------------------------------------------------------
//  Documentos adjuntos
// ---------------------------------------------------------
model Document {
  id         String    @id @default(cuid())
  name       String
  type       String?
  url        String
  investor   Investor? @relation(fields: [investorId], references: [id], onDelete: Cascade)
  investorId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId String?
  uploadedAt DateTime  @default(now())
}

// ---------------------------------------------------------
//  Alertas del sistema
// ---------------------------------------------------------
model Alert {
  id        String   @id @default(cuid())
  // INFO | WARNING | DANGER | SUCCESS
  level     String   @default("INFO")
  title     String
  message   String
  category  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
//  Bitácora / logs del sistema
// ---------------------------------------------------------
model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  action    String
  entity    String?
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
//  Capital entregado a trabajadores (caja de cada operador)
//
//  Cada fila es un movimiento de custodia: la empresa le pasa
//  efectivo a un trabajador para que lo coloque en préstamos
//  (ASSIGN), o el trabajador devuelve efectivo (RETURN).
//
//  NO es un movimiento de capital de la empresa: la plata sigue
//  siendo del fondo, solo cambia de manos. Por eso no genera
//  CapitalMovement ni afecta la liquidez global; lo que sí afecta
//  la liquidez es cuando ese efectivo se coloca en una Operation.
//
//  El efectivo en mano del trabajador se deriva de estas filas
//  más sus operaciones y cobros (ver src/lib/data/staff-capital.ts).
// ---------------------------------------------------------
model StaffAssignment {
  id        String   @id @default(cuid())
  user      User     @relation("StaffAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // ASSIGN | RETURN
  type      String   @default("ASSIGN")
  amount    Float
  note      String?
  date      DateTime @default(now())
  // Admin que registró el movimiento
  author    User?    @relation("StaffAssignmentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorId  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([date])
}

// ---------------------------------------------------------
//  Configuración de la empresa (singleton)
// ---------------------------------------------------------
model CompanySettings {
  id                String   @id @default("singleton")
  companyName       String   @default("Capital Veci")
  legalName         String?
  taxId             String?
  currency          String   @default("CLP")
  // % de capital que debe mantenerse en reserva
  reservePercentage Float    @default(20)
  // Liquidez mínima absoluta exigida
  minLiquidity      Float    @default(0)
  // % máximo de capital comprometido permitido
  maxCommitment     Float    @default(80)
  alertsEnabled     Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}
